				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "A once large empire left to ruins after a great war in the Winter of 1911."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
